APP_NAME=Lykos
NODE_ENV=development
LOG_LEVEL=info
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# Discord secrets stay outside Git. Leave empty for health/config-only local runs.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

MYSQL_URI=mysql://alkabot:alkabot_dev_password@127.0.0.1:3306/alkabot
REDIS_URL=redis://127.0.0.1:6379

# Must match the configured AlkaBridge secret in production.
BRIDGE_HMAC_SECRET=
BRIDGE_TRANSPORT_ENABLED=false
BRIDGE_REDIS_NAMESPACE=alka
BRIDGE_SCAN_INTERVAL_MS=5000
BRIDGE_HEARTBEAT_STALE_MS=30000
BRIDGE_COMMAND_TTL_MS=30000
BRIDGE_COMMAND_RESULT_WAIT_MS=3000

# Comma-separated Discord snowflakes. Admin IDs/roles grant every modeled Alka permission.
POLICY_ADMIN_DISCORD_IDS=
POLICY_ADMIN_ROLE_IDS=
POLICY_NETWORK_READ_ROLE_IDS=
POLICY_AUDIT_READ_ROLE_IDS=
POLICY_SETUP_READ_ROLE_IDS=
POLICY_SETUP_WRITE_ROLE_IDS=
POLICY_STAFF_READ_ROLE_IDS=

# Link codes are stored hashed and are single-use.
LINK_CODE_TTL_SECONDS=300
LINK_CODE_RATE_LIMIT_SECONDS=30

# Required outside development/test for /internal routes.
INTERNAL_API_TOKEN=
